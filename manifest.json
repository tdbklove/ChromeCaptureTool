{
  "manifest_version": 3,
  "name": "截圖與裁切 - My Screenshot Cropper",
  "version": "1.18.1",
  "description": "單張截圖、長條截圖與翻頁截圖，自動偵測圖片並裁切、移除空白與廣告間隔。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "截圖與裁切",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "開啟截圖選單"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "擷取目前畫面"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "自動捲動並拼接長圖"
    },
    "capture-pages": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "翻頁截圖（自動按「→」鍵逐頁擷取）"
    }
  }
}
